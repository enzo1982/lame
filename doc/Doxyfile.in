# Doxyfile 1.17.0
#
# Public API documentation for LAME.
#
# The shared configuration lives in Doxyfile-common; this file @INCLUDEs it and
# then sets only the options specific to the public API documentation. The
# parallel Doxyfile-internal additionally covers the static internals and the
# unit-test suite, for people working on LAME itself.
#
# Doxygen applies later settings over earlier ones, so the assignments below
# override the values pulled in from Doxyfile-common.

@INCLUDE_PATH          = .
@INCLUDE               = Doxyfile-common

# These options are kept out of the common file so the public and internal docs
# can diverge on them independently.

# The public API documentation parses no unit tests, so there is nothing for a
# test list to collect.
GENERATE_TESTLIST      = NO

# Public and internal functions live side by side in the same files and are
# told apart by the \internal marker rather than by excluding directories -
# excluding libmp3lame would drop the public API itself, which is defined
# there. INTERNAL_DOCS=NO already strips the body of an \internal comment, but
# that alone leaves the entity behind as an undocumented member, so its name
# would still appear here. Hiding undocumented members is what completes the
# split. The internal configuration does not override the common NO, so it
# goes on showing everything.
HIDE_UNDOC_MEMBERS     = YES

# The same argument for compounds. Every struct in libmp3lame and frontend is
# an internal type - lame_version_t in the public header is the only one a
# caller ever names - so without this the public reference lists dozens of
# them, and warns about each. A public struct that nobody documented would be
# hidden too, which is the intended pressure: it belongs in the documented set,
# not in the reference as a bare name.
HIDE_UNDOC_CLASSES     = YES

# The public interface is one header, so its file page is the API reference.
# This layout is Doxygen's own default plus an entry naming it, so a caller
# does not have to find it under a list of implementation files.
LAYOUT_FILE            = @LAME_SRCDIR@/doc/doxygen/DoxygenLayout.xml

# A file page here lists the headers that translation unit includes, which for
# the public reference means internal headers a caller may not include and that
# are not even installed. The internal documentation is where that is useful.
SHOW_INCLUDE_FILES     = NO

# The frame analyzer is a program, not part of the library interface, so its
# sources are described for the user on their own page rather than published as
# file references here. This has to be an exclusion: \internal does NOT keep a
# file out of the public set - it suppresses the description text and leaves
# behind an empty file page in the index, which HIDE_UNDOC_MEMBERS cannot reach
# because it has no members. Verified against the rendered HTML, not the
# settings.
EXCLUDE_PATTERNS       = */frontend/mp3x_*

# A verbatim copy of every header the documentation parses, one page each, is
# not part of an API reference: it published the complete source of the encoder
# internals - the psychoacoustic model, the quantizer, the bit reservoir - and
# listed all of them in the public file index as though a caller could use them.
# The interface a caller may use is what this document describes; the source
# itself is in the release tarball and the repository. The internal
# configuration does not override the common YES, so it goes on carrying them.
VERBATIM_HEADERS       = NO

# Call graphs need Graphviz/dot and slow the build; off for the public docs.
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
