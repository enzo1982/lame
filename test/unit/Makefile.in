AUTOMAKE_OPTIONS = 1.15 foreign

# The frontend's exit status on a failed read. This one drives the built lame
# binary rather than the library, so it needs the source root for the test
# input as well as the build root for the binary; both are exported below.
@ENABLE_UNIT_TESTS_TRUE@TESTS = $(check_PROGRAMS) test_pkgconfig.sh \
@ENABLE_UNIT_TESTS_TRUE@	test_exit_status.sh
@ENABLE_UNIT_TESTS_TRUE@TEST_EXTENSIONS = .sh
@ENABLE_UNIT_TESTS_TRUE@SH_LOG_COMPILER = $(SHELL)

# Every test here links libmp3lame, and every one of them has to load the copy
# this build just produced - not one the host happens to have installed. That
# is not automatic. Libtool's Unix wrapper is a shell script and exports
# LD_LIBRARY_PATH itself, but on Windows it generates a wrapper executable that
# does nothing equivalent for PATH, so the suite there loads the installed DLL
# instead and reports on a library nobody asked about. Naming the directory
# here settles it the same way on every platform rather than leaving it to
# libtool. Both variables are set because the two families of systems consult
# different ones, and neither is harmful where it is not used.

# test_pkgconfig.sh reads the generated lame.pc and the libmp3lame.la libtool
# wrote beside it, and asks pkg-config what the first one means. It needs the
# build and source roots by absolute path because it runs from this directory,
# and the pkg-config configure settled on rather than whichever one is first
# on PATH.
@ENABLE_UNIT_TESTS_TRUE@AM_TESTS_ENVIRONMENT = LD_LIBRARY_PATH="$(abs_top_builddir)/libmp3lame/.libs$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}"; \
@ENABLE_UNIT_TESTS_TRUE@	export LD_LIBRARY_PATH; \
@ENABLE_UNIT_TESTS_TRUE@	PATH="$(abs_top_builddir)/libmp3lame/.libs:$$PATH"; \
@ENABLE_UNIT_TESTS_TRUE@	export PATH; \
@ENABLE_UNIT_TESTS_TRUE@	abs_top_builddir='$(abs_top_builddir)'; \
@ENABLE_UNIT_TESTS_TRUE@	export abs_top_builddir; \
@ENABLE_UNIT_TESTS_TRUE@	abs_top_srcdir='$(abs_top_srcdir)'; \
@ENABLE_UNIT_TESTS_TRUE@	export abs_top_srcdir; \
@ENABLE_UNIT_TESTS_TRUE@	PKG_CONFIG='$(PKG_CONFIG)'; export \
@ENABLE_UNIT_TESTS_TRUE@	PKG_CONFIG;
@ENABLE_UNIT_TESTS_TRUE@test_sanity_SOURCES = test_sanity.c
@ENABLE_UNIT_TESTS_TRUE@test_sanity_CPPFLAGS = $(CMOCKA_CFLAGS)
@ENABLE_UNIT_TESTS_TRUE@test_sanity_LDADD = $(CMOCKA_LIBS)

# The AIFF header parser lives in frontend/get_audio.c and is static, so the
# test compiles it in directly (hence the frontend/libmp3lame/include search
# paths). fread is wrapped to trap the underflow spin the guard prevents.
@ENABLE_UNIT_TESTS_TRUE@test_get_audio_aiff_SOURCES = test_get_audio_aiff.c test_stubs.c
@ENABLE_UNIT_TESTS_TRUE@test_get_audio_aiff_CPPFLAGS = $(CMOCKA_CFLAGS) \
@ENABLE_UNIT_TESTS_TRUE@	-I$(top_srcdir)/frontend \
@ENABLE_UNIT_TESTS_TRUE@	-I$(top_srcdir)/libmp3lame \
@ENABLE_UNIT_TESTS_TRUE@	-I$(top_srcdir)/include \
@ENABLE_UNIT_TESTS_TRUE@	-I$(top_builddir)

@ENABLE_UNIT_TESTS_TRUE@test_get_audio_aiff_LDFLAGS = -Wl,--wrap=fread
# Compiling get_audio.c in means this test inherits whichever file io backend
# configure selected, so it needs that backend's libraries too: under
# --with-fileio=sndfile the file calls libsndfile directly. SNDFILE_LIBS is
# empty for the default backend, so this costs nothing there. The compile side
# already works, because SNDFILE_CFLAGS reaches every target through INCLUDES.
@ENABLE_UNIT_TESTS_TRUE@test_get_audio_aiff_LDADD = $(CMOCKA_LIBS) \
@ENABLE_UNIT_TESTS_TRUE@	$(top_builddir)/libmp3lame/libmp3lame.la \
@ENABLE_UNIT_TESTS_TRUE@	$(SNDFILE_LIBS)


# The WAVE header parser is static in the same file, so the same arrangement
# applies - minus the fread wrapper, which exists for an AIFF chunk loop this
# parser does not have.
@ENABLE_UNIT_TESTS_TRUE@test_get_audio_wav_SOURCES = test_get_audio_wav.c test_stubs.c
@ENABLE_UNIT_TESTS_TRUE@test_get_audio_wav_CPPFLAGS = $(CMOCKA_CFLAGS) \
