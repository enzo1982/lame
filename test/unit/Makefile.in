@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-I$(top_srcdir)/include \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-I$(top_builddir)

@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@test_quantize_lines_vector_LDADD =  \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(CMOCKA_LIBS) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(top_builddir)/libmp3lame/vector/liblamevectorroutines.la \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-lm $(am__append_6) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(am__append_7)

# The VBR scalefactor-band noise gets the same arrangement, minus the AVX-512
# library: that routine was measured on hardware that has AVX-512, found to cost
# time, and removed. See @ref vector_dispatch.
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@test_calc_sfb_noise_vector_SOURCES = test_calc_sfb_noise_vector.c
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@test_calc_sfb_noise_vector_CPPFLAGS = $(CMOCKA_CFLAGS) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-I$(top_srcdir)/libmp3lame \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-I$(top_srcdir)/include \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-I$(top_builddir)

@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@test_calc_sfb_noise_vector_LDADD =  \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(CMOCKA_LIBS) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(top_builddir)/libmp3lame/vector/liblamevectorroutines.la \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	-lm $(am__append_8) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_XMM_TRUE@	$(am__append_9)

# The ARM tier carries one routine, so it gets one test program rather than an
# arm of the x86 file - that one names the SSE2 and AVX2 routines throughout, so
# there is no shared body to add to.
#
# OUTSIDE the WITH_XMM block above, which is the whole point: the first version
# of this sat inside it, so on an ARM host - where WITH_XMM is false - the
# _SOURCES and _LDADD never expanded while the program stayed in
# check_PROGRAMS. automake emitted a link command with no objects and no
# libraries at all, and the failure was `undefined symbol: main`, which names
# neither the program nor the conditional.
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@test_choose_table_neon_SOURCES = test_choose_table_neon.c
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@test_choose_table_neon_CPPFLAGS = $(CMOCKA_CFLAGS) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@	-I$(top_srcdir)/libmp3lame \
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@	-I$(top_srcdir)/include \
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@	-I$(top_builddir)

@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@test_choose_table_neon_LDADD = $(CMOCKA_LIBS) \
@ENABLE_UNIT_TESTS_TRUE@@WITH_NEON_TRUE@	$(top_builddir)/libmp3lame/vector/liblamevectorneon.la


# rtp_socket() is external but the file is a frontend translation unit, not part
# of the library, so the test compiles it in directly - the same arrangement the
# get_audio and parse tests use. It needs the resolver library on the platforms
# where that is separate, which is what SOCKET_LIBS carries; mp3rtp links the
# same one. The lone frontend symbol rtp.c reaches for, error_printf(), is
# stubbed inside the test rather than dragging in console.c.
@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@test_rtp_socket_SOURCES = test_rtp_socket.c $(top_srcdir)/frontend/rtp.c
@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@test_rtp_socket_CPPFLAGS = $(CMOCKA_CFLAGS) \
@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@	-I$(top_srcdir)/frontend \
@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@	-I$(top_srcdir)/include \
@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@	-I$(top_builddir)

@ENABLE_UNIT_TESTS_TRUE@@HAVE_SOCKETS_TRUE@test_rtp_socket_LDADD = $(CMOCKA_LIBS) @SOCKET_LIBS@

# Kept in the tarball whether or not this build configured the vector code,
# so a dist made on one architecture still carries the tests for another.

# Header-only unused-parameter marker shared by the tests; not a _SOURCES file,
# so it has to be named for the tarball explicitly.

# Likewise the pkg-config test: it is a TESTS entry rather than a _SOURCES
# file, and it is inside the --enable-unit-tests conditional, so neither route
# would put it in the tarball on its own.

# And the exit-status test, for the same two reasons.
EXTRA_DIST = test_choose_table_vector.c test_quantize_lines_vector.c \
	test_calc_sfb_noise_vector.c test_choose_table_neon.c \
	test_rtp_socket.c test_unused.h test_pkgconfig.sh \
	test_exit_status.sh
all: all-am

.SUFFIXES:
.SUFFIXES: .c .lo .log .o .obj .sh .sh$(EXEEXT) .trs
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am $(top_srcdir)/Makefile.am.global $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign test/unit/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign test/unit/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/Makefile.am.global $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-checkPROGRAMS:
	$(am__rm_f) $(check_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(check_PROGRAMS:$(EXEEXT)=)

