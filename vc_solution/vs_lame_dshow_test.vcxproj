  <!--
    Deliberately not gated on HaveDShowBaseClasses, unlike the filter itself.
    This program does not derive from the base classes and does not include
    streams.h: it loads the built lame.ax at run time and talks to it through
    COM, so it compiles against the Windows SDK alone. Whether the filter is
    there is a run-time question, and the test answers it - skipping when it is
    absent, and fails instead when its caller says to require one.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <AdditionalIncludeDirectories>../test/clients;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
