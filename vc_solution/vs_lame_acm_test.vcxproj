  <PropertyGroup Label="UserMacros" />
  <!--
    The codec's own sources are compiled in, so every option that changes how
    they are interpreted has to match vs_lame_acm.vcxproj. TreatWChar_tAsBuiltInType
    is the one that is not cosmetic: without it ACM.cpp does not compile at all,
    because it passes WCHAR arrays to parameters declared unsigned short.
    vs_clients_config.props is imported for the same reason: it carries the one
    warning suppression those sources need, and without it they are built twice
    under two different warning configurations.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <AdditionalIncludeDirectories>../include;../ACM;../ACM/ddk;../test/clients;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;WIN32;LAME_ACM;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <TreatWChar_tAsBuiltInType>false</TreatWChar_tAsBuiltInType>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>winmm.lib;msacm32.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
