CLEANFILES = lclint.txt vcsrevision.h vcsrevision.h.tmp

# vcsrevision.h names the revision of the working copy the library is built
# from, for the version string of an alpha or beta build: "svn-r6830" or
# "svn-r6830M" from svnversion, else "git-1a2b3c4" or "git-1a2b3c4M" from git
# when the sources are tracked there, else nothing. The header is remade on
# every make and rewritten only when the answer changed, so version.c
# recompiles only then.
BUILT_SOURCES = vcsrevision.h

vcsrevision.h: FORCE
	@rev=; \
	if test -n "$(SVNVERSION)"; then \
	  r=`"$(SVNVERSION)" "$(top_srcdir)" 2>/dev/null`; \
	  case $$r in [0-9]*) rev="svn-r$$r";; esac; \
	fi; \
	if test -z "$$rev" && test -n "$(GIT)" \
	   && "$(GIT)" -C "$(top_srcdir)" ls-files --error-unmatch \
	        libmp3lame/version.c >/dev/null 2>&1; then \
	  r=`"$(GIT)" -C "$(top_srcdir)" rev-parse --short HEAD 2>/dev/null`; \
	  if test -n "$$r"; then \
	    "$(GIT)" -C "$(top_srcdir)" diff --quiet HEAD -- . 2>/dev/null || r="$${r}M"; \
	    rev="git-$$r"; \
	  fi; \
	fi; \
	{ echo '/* Generated by libmp3lame/Makefile.am; do not edit. */'; \
	  test -z "$$rev" || echo "#define LAME_VCS_REVISION \"$$rev\""; \
	} > vcsrevision.h.tmp; \
	if cmp -s vcsrevision.h.tmp vcsrevision.h; then rm -f vcsrevision.h.tmp; \
	else mv -f vcsrevision.h.tmp vcsrevision.h; fi

FORCE:

LCLINTFLAGS= \
	+posixlib \
	+showsummary \
	+showalluses \
	+whichlib \
	+forcehints \
	-fixedformalarray \
	+matchanyintegral \
	-Dlint

lclint.txt: ${libmp3lame_la_SOURCES} ${noinst_HEADERS}
	@lclint ${LCLINTFLAGS} ${AM_CPPFLAGS} ${DEFS} ${libmp3lame_la_SOURCES} 2>&1 >lclint.txt || true

lclint: lclint.txt
	more lclint.txt

