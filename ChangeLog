	  Makefile.in, config.h.in, configMS.h, configure, configure.ac,
	  doc/Makefile.in, doc/html/Makefile.in, doc/html/history.html,
	  doc/man/Makefile.in, doc/man/mp3rtp.1, dshow/Makefile.in,
	  frontend/Makefile.am, frontend/Makefile.in, frontend/mp3rtp.c,
